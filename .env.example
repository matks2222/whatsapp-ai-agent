# Clave de la API de Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (developers.facebook.com > tu app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Lo inventas tú; debe coincidir con el "Verify token" del webhook en Meta
WHATSAPP_VERIFY_TOKEN=

# App Secret de tu app de Meta (Configuración > Básica). Activa la validación de firma.
WHATSAPP_APP_SECRET=

# Opcional
# BUSINESS_CONFIG=business-context.json
# PORT=3000
# ENABLE_TEST_ROUTE=true   # solo para pruebas locales, no en producción
